{
  "name": "xcode-i18n",
  "displayName": "Xcode Localization",
  "description": "Visual editor for Xcode String Catalogs (.xcstrings) and legacy .strings — localize iOS, iPadOS & macOS apps in VS Code with a spreadsheet grid, clean git diffs, and translation progress.",
  "version": "1.0.2",
  "license": "MIT",
  "icon": "assets/icon.png",
  "publisher": "dphans-github",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dphans/vscode_xcode_localization.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "xcode",
    "ios",
    "ipados",
    "macos",
    "swift",
    "swiftui",
    "objective-c",
    "localization",
    "internationalization",
    "i18n",
    "l10n",
    "translation",
    "xcstrings",
    "string catalog",
    "strings",
    "localizable",
    "apple"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "xcodeI18n.xcstringsEditor",
        "displayName": "Xcode String Catalog",
        "selector": [
          {
            "filenamePattern": "*.xcstrings"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "xcodeI18n.xcstringsEditor",
        "displayName": "String Catalog",
        "selector": [
          {
            "filenamePattern": "*.strings.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "xcodeI18n.stringsEditor",
        "displayName": "Xcode .strings (i18n grid)",
        "selector": [
          {
            "filenamePattern": "*.strings"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "git:/**/*.xcstrings": "default",
        "git:/**/*.strings.json": "default",
        "git:/**/*.strings": "default",
        "gitlens:/**/*.xcstrings": "default",
        "gitlens:/**/*.strings.json": "default",
        "gitlens:/**/*.strings": "default"
      }
    },
    "commands": [
      {
        "command": "xcodeI18n.openAsText",
        "title": "Open as Text",
        "category": "Xcode Localization",
        "icon": "$(go-to-file)"
      },
      {
        "command": "xcodeI18n.refreshLocalizations",
        "title": "Refresh",
        "category": "Xcode Localization",
        "icon": "$(refresh)"
      },
      {
        "command": "xcodeI18n.addLanguage",
        "title": "Add Language…",
        "category": "Xcode Localization",
        "icon": "$(add)"
      },
      {
        "command": "xcodeI18n.removeLanguage",
        "title": "Remove Language…",
        "category": "Xcode Localization",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xcodeI18n",
          "title": "Xcode Localization",
          "icon": "assets/activity.svg"
        }
      ]
    },
    "views": {
      "xcodeI18n": [
        {
          "id": "xcodeI18n.localizations",
          "name": "Xcode Localization"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xcodeI18n.localizations",
        "contents": "No localizations found in this workspace.\n\nThis view lists .xcstrings String Catalogs and legacy <lang>.lproj/*.strings files. Open a folder that contains them to see languages and translation progress here."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xcodeI18n.openAsText",
          "when": "activeCustomEditorId == xcodeI18n.xcstringsEditor || activeCustomEditorId == xcodeI18n.stringsEditor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "xcodeI18n.refreshLocalizations",
          "when": "view == xcodeI18n.localizations",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "xcodeI18n.addLanguage",
          "when": "view == xcodeI18n.localizations && viewItem =~ /^xcodeI18n\\.(catalog|table|catalogLanguage|language)/",
          "group": "inline@1"
        },
        {
          "command": "xcodeI18n.addLanguage",
          "when": "view == xcodeI18n.localizations && viewItem =~ /^xcodeI18n\\.(catalog|table|catalogLanguage|language)/",
          "group": "1_manage@1"
        },
        {
          "command": "xcodeI18n.removeLanguage",
          "when": "view == xcodeI18n.localizations && viewItem =~ /\\.removable$/",
          "group": "1_manage@2"
        }
      ]
    },
    "configuration": {
      "title": "Xcode Localization",
      "properties": {
        "xcodeI18n.displayMode": {
          "type": "string",
          "enum": ["comfortable", "compact"],
          "enumDescriptions": [
            "Roomier rows with more padding (default).",
            "Tighter rows so more fit on screen."
          ],
          "default": "comfortable",
          "description": "Row density for the String Catalog grid."
        },
        "xcodeI18n.mergeKeySource": {
          "type": "boolean",
          "default": true,
          "description": "Merge the Key and source columns into one. The key shows as a secondary line only when it differs from the source value. Uncheck to show Key and source as separate columns."
        },
        "xcodeI18n.doubleClickToEdit": {
          "type": "boolean",
          "default": true,
          "description": "Require a double-click to open a cell for editing; a single click only selects it. Uncheck to open the editor with a single click."
        },
        "xcodeI18n.showCommentColumn": {
          "type": "boolean",
          "default": true,
          "description": "Show the Comment column — the developer note for each key, in its own column the way Xcode shows it. When off, the note appears under the key instead."
        },
        "xcodeI18n.showStateColumn": {
          "type": "boolean",
          "default": true,
          "description": "Show the State column: a green check when a string is translated, an orange NEW square when it isn't, and a label for every other state. It reports on the first target language shown."
        },
        "xcodeI18n.allowRemovingManagedStrings": {
          "type": "boolean",
          "default": false,
          "description": "Allow deleting keys that Xcode manages automatically. Off by default: such a key is extracted from your source code, so deleting it here only postpones it until the next build. Keys added by hand can always be deleted."
        },
        "xcodeI18n.catalogFilePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.xcstrings"
          ],
          "markdownDescription": "File name patterns opened as String Catalogs, e.g. `*.strings.json`. Patterns other than the built-in `*.xcstrings` are registered in `#workbench.editorAssociations#` so VS Code routes them to this editor; removing a pattern here removes that association again."
        },
        "xcodeI18n.sourceFilePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.swift",
            "*.m",
            "*.mm"
          ],
          "markdownDescription": "File name patterns counted as source code by **Find in code** and **Find unused keys**. Add `*.ts`, `*.tsx`, `*.js` and the like to use this extension outside an Xcode project — quoted literals are matched in double, single and backtick quotes."
        },
        "xcodeI18n.languageNames": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Display names for language tags VS Code doesn't recognise, e.g. `{ \"en-Pseudo\": \"English (Pseudo)\" }`. Everything else keeps its standard name."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
