        "es-419": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Périmé mais déjà traduit"
          }
        }
      }
    },
    "Welcome, %@!": {
      "comment": "Greeting on the home screen. %@ is the member's first name.",
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue !"
          }
        }
      }
    },
    "{count, plural, one {# unread message} other {# unread messages}}": {
      "comment": "ICU plural. Valid in both languages.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{count, plural, one {# message non lu} other {# messages non lus}}"
          }
        }
      }
    },
    "{gender, select, female {She} male {He} other {They}} shared {count, plural, one {a photo} other {# photos}}": {
      "comment": "Nested ICU select + plural, to show brace-depth colouring.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{gender, select, female {Elle} male {Il} other {Iel}} a partagé {count, plural, one {une photo} other {# photos}}"
          }
        }
      }
    },
    "ICU: missing other branch": {
      "comment": "The translation drops the required fallback branch — ICU throws at format time.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{count, plural, one {# élément}}"
          }
        }
      }
    },
    "ICU: unbalanced brace": {
      "comment": "The translation is missing its closing brace.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{count, plural, one {# élément} other {# éléments}"
          }
        }
      }
    },
    "ICU: misspelled branch": {
      "comment": "\"ones\" is not a CLDR plural category.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{count, plural, ones {# élément} other {# éléments}}"
          }
        }
      }
    },
    "Signed in as {name}": {
      "comment": "The translation renames the placeholder, so it never substitutes.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté en tant que {nom}"
          }
        }
      }
    },
    "Escaped '{braces}' stay literal": {
      "comment": "Quoted runs turn ICU syntax back into plain text.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les '{accolades}' restent littérales"
          }
        }
      }
    },
    "{0} has a secret plan. You''ll see. You''ll all see.": {
      "comment": "Doubled apostrophes are ICU escapes — the preview resolves them to one.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} a un plan secret. Vous verrez. Vous verrez tous."
          }
        }
      }
    }
  },
  "version": "1.0"
}
